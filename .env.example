# ---------------------------------------------------------------------------
# political-shorts configuration. Copy this file to `.env` and edit.
# Nothing here is a real credential. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- General -----------------------------------------------------------------
# Timezone used for scheduling & metadata timestamps.
TIMEZONE=Asia/Seoul
# How many hours back to look when collecting news.
COLLECT_WINDOW_HOURS=18
# Max number of shorts to build per pipeline run.
MAX_ITEMS_PER_RUN=3
# Minimum number of independent sources before a statement may be presented
# as fact (used by the safety layer).
MIN_SOURCES_FOR_FACT=2
# Don't build/publish another short about a story already covered in the last
# N days (0 disables). A run walks on to the next distinct issue instead.
TOPIC_DEDUP_DAYS=5
# Keyword-overlap ratio (0-1) that counts two stories as "the same".
TOPIC_DEDUP_THRESHOLD=0.6
# Retry a failed upload this many times on transient network errors.
PUBLISH_RETRIES=3
# Re-rank the build order by Google Trends (KR) so the story people are
# actually searching right now is made first. Best-effort; free, no key.
TRENDING_ENABLED=true

# --- Text-to-speech --------------------------------------------------------
# true  -> synthesize narration; false -> silent video (captions only)
ENABLE_TTS=true
# Provider: edge | elevenlabs | azure | gcloud | openai | sapi
#   edge       - FREE, no key, Microsoft neural voices (needs `pip install edge-tts`)
#   elevenlabs - best quality, paid  (ELEVENLABS_API_KEY)
#   azure      - very natural, free tier then paid  (AZURE_SPEECH_KEY/REGION)
#   gcloud     - good, generous free tier  (GOOGLE_TTS_API_KEY)
#   openai     - simple, paid  (OPENAI_API_KEY, shared with LLM)
#   sapi       - offline Windows SAPI (robotic; used as last-resort fallback anyway)
TTS_PROVIDER=edge
# Voice name/id for the chosen provider. Blank = provider default.
#   edge/azure : ko-KR-SunHiNeural | ko-KR-InJoonNeural | ko-KR-HyunsuNeural
#   gcloud     : ko-KR-Neural2-A | ko-KR-Neural2-C | ko-KR-Wavenet-A
#   elevenlabs : a voice_id (see ELEVENLABS_VOICE_ID below instead)
#   openai     : alloy | nova | shimmer | ...
TTS_VOICE=
# Speaking pace. 175 = normal, 215 = fast (current), 240+ = very fast.
TTS_RATE=198

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

GOOGLE_TTS_API_KEY=

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Video ---------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
# Seconds per caption card when TTS is disabled.
CARD_SECONDS=3.5
# Absolute path to a Unicode/Korean-capable .ttf. Malgun Gothic ships with Win11.
FONT_PATH=C:\Windows\Fonts\malgun.ttf
FONT_BOLD_PATH=C:\Windows\Fonts\malgunbd.ttf
# Display fonts for the thumbnail-style title / labels / captions
# (bundled in assets\fonts\, SIL OFL, free for commercial use).
FONT_TITLE=assets\fonts\BlackHanSans-Regular.ttf
FONT_LABEL=assets\fonts\DoHyeon-Regular.ttf
FONT_BODY=assets\fonts\Jua-Regular.ttf
# Path to ffmpeg. "ffmpeg" works if it is on PATH.
FFMPEG_PATH=ffmpeg
# Slow zoom/pan on the photos. false = static images.
KEN_BURNS=true
# Designed opening frame (the Shorts poster): big face on an accent panel, a
# huge boxed headline, an issue badge. false = start straight on card 1.
THUMB_ENABLED=true
# How long to hold that opening frame, in seconds.
THUMB_HOLD_SECONDS=1.3

# --- Content style -------------------------------------------------------
# punchy = curiosity-gap hook + middle-school explanation + fact-check card
# neutral = plain "just the facts" summary (the old behaviour)
HEADLINE_STYLE=punchy
FACTCHECK_SEGMENT=true

# --- Images (keyless, free: Korean Wikipedia + Wikimedia Commons) -----------
# Every video gets a real photo of the National Assembly building, plus a
# portrait of any politician named in the headline that has a proper Wikipedia
# article (ambiguous names like 김용범 are skipped — never a guessed face).
# Cards with no photo use a drawn iconographic backdrop (see video.py).
IMAGE_ENABLED=true
IMAGE_MIN_COUNT=1
IMAGE_MAX_COUNT=6
IMAGE_PROVIDERS=wikipedia
IMAGE_CACHE_DIR=assets\cache\images

# --- Background music --------------------------------------------------------
# Ships with "Investigations" by Kevin MacLeod (incompetech.com, CC BY 4.0).
# BGM_CREDIT is appended to every video description (CC BY requires attribution).
# Swap in your own track: drop it in assets\bgm\ and update BGM_PATH + BGM_CREDIT.
BGM_ENABLED=true
BGM_PATH=assets\bgm\investigations_kmacleod.mp3
BGM_CREDIT=음악: "Investigations" Kevin MacLeod (incompetech.com) — CC BY 4.0
# How far under the narration the bed sits (dB). -26 subtle, -20 present, -16 loud.
BGM_VOLUME_DB=-23
# true -> side-chain duck: the bed dips automatically while the voice is talking.
BGM_DUCK=true
BGM_FADE_SECONDS=2

# --- Optional LLM assist (script polishing & classification) --------------
# Leave blank to run fully offline with the built-in heuristic templates.
LLM_PROVIDER=
# anthropic | openai | (empty)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# --- Dashboard ------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# --- Publishing (ALL OFF BY DEFAULT) ------------------------------------
# Master switch. While false, every publisher runs in dry-run mode and only
# logs what it *would* have done.
ENABLE_PUBLISH=false

# YouTube Data API v3 (OAuth desktop client)
YOUTUBE_CLIENT_SECRET_FILE=secrets\client_secret_youtube.json
YOUTUBE_TOKEN_FILE=secrets\token_youtube.json
# private | unlisted | public
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=25

# Instagram Graph API (requires a Business/Creator account + a public video URL)
INSTAGRAM_ENABLED=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public base URL that serves files from ./output (Graph API downloads from here)
PUBLIC_MEDIA_BASE_URL=

# TikTok Content Posting API (pull-from-URL)
TIKTOK_ENABLED=false
TIKTOK_ACCESS_TOKEN=
